# Copier en « .env » à la racine du dépôt (jamais commité) puis remplir chaque valeur.
# Générer un secret : openssl rand -base64 48

# Nom de domaine public de l'application (ex : presence.ma-pharmacie.fr)
DOMAINE=
# Adresse e-mail pour les alertes d'expiration Let's Encrypt
EMAIL_LETSENCRYPT=

# Base de données
POSTGRES_DB=presence
POSTGRES_USER=presence
POSTGRES_PASSWORD=

# Secrets de l'application (au moins 32 caractères)
SECRET_KEY=
JWT_SECRET_KEY=

# Durée d'une session avant reconnexion (heures)
SESSION_HOURS=8

# Sauvegardes chiffrées : CONSERVEZ CETTE PHRASE EN LIEU SÛR (sans elle, les sauvegardes sont illisibles)
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Copie hors site (profil « horssite ») : <remote rclone>:<dossier>
RCLONE_DESTINATION=
