# Mode d'amorçage : pas encore de certificat. Seul le défi Let's Encrypt est servi.
server {
    listen 80;
    server_name ${DOMAINE};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        default_type text/plain;
        return 503 "Certificat HTTPS en cours d'obtention. Voir docs/deploiement.md.\n";
    }
}
